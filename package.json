{
  "name": "lingxi",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "pnpm -r test && vitest run --dir scripts",
    "typecheck": "pnpm -r typecheck && tsc -p scripts && tsc -p e2e",
    "judge:check": "tsx scripts/judge-check.mts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "status:check": "tsx scripts/status-check.mts",
    "claims:check": "tsx scripts/claims-check.mts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "test:fork": "tsx scripts/fork-tests.mts",
    "coverage": "tsx scripts/coverage.mts",
    "revert:check": "tsx scripts/revert-check.mts",
    "site:release": "tsx scripts/site-release.mts",
    "readme:banner": "tsx scripts/readme-banner.mts",
    "readme:shots": "tsx scripts/readme-shots.mts",
    "readme:phones": "tsx scripts/readme-phones.mts",
    "perf:budget": "tsx scripts/perf-budget.mts",
    "perf:lighthouse": "tsx scripts/lighthouse-budget.mts",
    "numbers:snapshot": "tsx services/api/scripts/numbers-snapshot.mts",
    "server:release": "pnpm --filter @lingxi/api build && npx pm2 startOrReload deploy/pm2.config.cjs --only lingxi-server --update-env",
    "screens:inventory": "tsx scripts/screen-inventory.mts",
    "share:cards": "tsx scripts/share-cards.mts"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@lingxi/art": "workspace:*",
    "@lingxi/brain": "workspace:*",
    "@lingxi/chain": "workspace:*",
    "@lingxi/game": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/madge": "5.0.3",
    "@types/node": "22.15.30",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "3.2.4",
    "axe-core": "4.10.2",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "14.0.0",
    "madge": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.18.1",
    "viem": "2.57.7",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
