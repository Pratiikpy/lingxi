{
  "name": "@lingxi/chain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./player": "./src/player.ts",
    "./limits": "./src/limits.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "tapeout": "tsx scripts/tapeout.ts",
    "recount": "tsx scripts/recount-numbers.ts --deployment deployments/xlayer.json --api https://lingxi.knole.me",
    "publish:deweb": "tsx scripts/publish-deweb.ts --deployment deployments/xlayer.json --rpc https://xlayerrpc.okx.com --mainnet-yes"
  },
  "dependencies": {
    "@lingxi/art": "workspace:*",
    "@lingxi/brain": "workspace:*",
    "@lingxi/game": "workspace:*",
    "@lingxi/send": "workspace:*",
    "@lingxi/world": "workspace:*",
    "@openzeppelin/merkle-tree": "1.0.8",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "sideEffects": false
}
